---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import EventCard from '../../components/EventCard.astro';
import RecordingCard from '../../components/RecordingCard.astro';
import { getCollection, getEntry } from 'astro:content';
import { isUpcoming } from '../../lib/dates';

const all = await getCollection('events');
const now = new Date();
const upcoming = all
  .filter((e) => isUpcoming(e.data.date, now))
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
const past = all
  .filter((e) => !isUpcoming(e.data.date, now))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Drafts show up in `npm run dev` only, so placeholder entries never ship.
const recordings = await Promise.all(
  (await getCollection('recordings', (r) => import.meta.env.DEV || !r.data.draft))
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
    .map(async (r) => ({
      ...r,
      eventTitle: r.data.event ? (await getEntry(r.data.event))?.data.title : undefined,
    })),
);
---
<BaseLayout title="Events — InterSynth Lab">
  <section class="container-page py-24">
    <SectionHeading eyebrow="Events" title="Talks, workshops, seminars." />

    <div class="mt-12">
      <h3 class="font-mono text-xs uppercase tracking-widest text-[color:var(--color-muted)]">Upcoming</h3>
      <div class="mt-6 grid gap-6 md:grid-cols-2">
        {upcoming.length === 0 && <p class="text-[color:var(--color-muted)]">No upcoming events scheduled — check back soon.</p>}
        {upcoming.map((e) => (
          <EventCard
            title={e.data.title}
            date={e.data.date}
            location={e.data.location}
            type={e.data.type}
            link={e.data.link}
            status="upcoming"
            excerpt={e.data.excerpt}
          />
        ))}
      </div>
    </div>

    {recordings.length > 0 && (
      <div class="mt-16">
        <h3 class="font-mono text-xs uppercase tracking-widest text-[color:var(--color-muted)]">Recordings</h3>
        <div class="mt-6 grid gap-6 md:grid-cols-2">
          {recordings.map((r) => (
            <RecordingCard
              title={r.data.title}
              date={r.data.date}
              speakers={r.data.speakers}
              provider={r.data.provider}
              videoId={r.data.videoId}
              url={r.data.url}
              duration={r.data.duration}
              eventTitle={r.eventTitle}
              excerpt={r.data.excerpt}
              draft={r.data.draft}
            />
          ))}
        </div>
      </div>
    )}

    {past.length > 0 && (
      <div class="mt-16">
        <h3 class="font-mono text-xs uppercase tracking-widest text-[color:var(--color-muted)]">Past</h3>
        <div class="mt-6 grid gap-6 md:grid-cols-2">
          {past.map((e) => (
            <EventCard
              title={e.data.title}
              date={e.data.date}
              location={e.data.location}
              type={e.data.type}
              link={e.data.link}
              status="past"
              excerpt={e.data.excerpt}
            />
          ))}
        </div>
      </div>
    )}
  </section>
</BaseLayout>
