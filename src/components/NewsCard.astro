---
interface Props {
  title: string;
  date: Date;
  excerpt?: string;
  href: string;
  tags?: string[];
}
const { title, date, excerpt, href, tags = [] } = Astro.props;
const fmt = new Intl.DateTimeFormat('en', { year: 'numeric', month: 'short', day: 'numeric' });
---
<a href={href} class="reveal gradient-border glass-hover block p-6">
  <div class="flex items-center justify-between text-xs">
    <time class="font-mono text-[color:var(--color-muted)]" datetime={date.toISOString()}>{fmt.format(date)}</time>
    {tags.length > 0 && <span class="chip">{tags[0]}</span>}
  </div>
  <h3 class="mt-3 text-lg font-semibold leading-snug">{title}</h3>
  {excerpt && <p class="mt-2 text-sm text-[color:var(--color-muted)]">{excerpt}</p>}
  <span class="mt-4 inline-flex items-center gap-1 text-xs font-mono text-[color:var(--color-accent-cyan)]">Read →</span>
</a>
