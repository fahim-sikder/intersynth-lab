---
import MeshBackground from './MeshBackground.astro';
interface Props {
  news: Array<{ id: string; data: { title: string; date: Date } }>;
}
const { news } = Astro.props;
---
<section class="relative overflow-hidden">
  <MeshBackground />
  <div class="container-page relative z-10 flex min-h-[88vh] flex-col justify-center py-24">
    <span class="chip mb-6 w-fit">
      <span class="inline-block h-1.5 w-1.5 rounded-full bg-[color:var(--color-accent-cyan)]"></span>
      WASP-HS Research Environment
    </span>

    <h1 class="text-5xl font-semibold leading-[1.05] tracking-tight sm:text-6xl md:text-7xl">
      Synthetic Data.<br />
      <span class="gradient-text">Real Questions.</span>
    </h1>

    <p class="mt-6 max-w-2xl text-lg text-[color:var(--color-muted)] sm:text-xl">
      The Interdisciplinary Synthetic Data Lab (InterSynth Lab) is an open and interdisciplinary <a href="https://wasp-hs.org">WASP-HS</a> research environment where social
      scientists and computer scientists investigate how synthetic data is made,
      represented, and trusted — and what that means for society.
    </p>

    <div class="mt-10 flex flex-wrap gap-3">
      <a href="/research" class="btn btn-primary">Our Research</a>
      <a href="/people" class="btn btn-ghost">Meet the Team</a>
    </div>

    {news.length > 0 && (
      <div class="mt-8 flex items-center gap-3 overflow-hidden">
        <span class="shrink-0 font-mono text-xs uppercase tracking-widest text-[color:var(--color-accent-cyan)]">Lab News</span>
        <div class="min-w-0 overflow-hidden [mask-image:linear-gradient(to_right,transparent_0%,black_4%,black_88%,transparent_100%)]">
          <div class="animate-ticker flex whitespace-nowrap">
            {[...news, ...news].map((item) => (
              <>
                <a
                  href={`/news/${item.id}`}
                  class="font-mono text-xs text-[color:var(--color-muted)] transition-colors hover:text-[color:var(--color-heading)]"
                >
                  <span class="text-[color:var(--color-accent-cyan)] opacity-70 mr-2">
                    {item.data.date.toLocaleDateString('en', { month: 'short', day: 'numeric' })}
                  </span>{item.data.title}
                </a>
                <span class="mx-4 inline-block h-1 w-1 shrink-0 self-center rounded-full bg-[color:var(--color-accent-cyan)] opacity-40 select-none"></span>
              </>
            ))}
          </div>
        </div>
      </div>
    )}

    <div class="mt-8 grid grid-cols-2 gap-6 border-t border-[color:var(--color-border)] pt-8 sm:grid-cols-4">
      <div>
        <div class="font-mono text-2xl text-[color:var(--color-heading)]">4</div>
        <div class="mt-1 text-xs uppercase tracking-widest text-[color:var(--color-muted)]">Universities</div>
      </div>
      <div>
        <div class="font-mono text-2xl text-[color:var(--color-heading)]">7+</div>
        <div class="mt-1 text-xs uppercase tracking-widest text-[color:var(--color-muted)]">Researchers</div>
      </div>
      <div>
        <div class="font-mono text-2xl text-[color:var(--color-heading)]">5</div>
        <div class="mt-1 text-xs uppercase tracking-widest text-[color:var(--color-muted)]">Research themes</div>
      </div>
      <div>
        <div class="font-mono text-2xl text-[color:var(--color-heading)]">∞</div>
        <div class="mt-1 text-xs uppercase tracking-widest text-[color:var(--color-muted)]">Open questions</div>
      </div>
    </div>
  </div>
</section>
