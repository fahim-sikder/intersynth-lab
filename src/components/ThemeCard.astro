---
interface Props {
  id?: string;
  title: string;
  summary: string;
  index?: number;
}
const { id, title, summary, index = 0 } = Astro.props;
const num = String(index + 1).padStart(2, '0');
const href = id ? `/themes/${id}` : undefined;
---
<article class="reveal gradient-border glass-hover p-6">
  <div class="flex items-baseline justify-between">
    <h3 class="text-lg font-semibold">
      {href ? <a href={href} class="hover:text-[color:var(--color-accent-cyan)]">{title}</a> : title}
    </h3>
    <span class="font-mono text-xs text-[color:var(--color-muted)]">/{num}</span>
  </div>
  <p class="mt-3 text-sm leading-relaxed text-[color:var(--color-muted)]">{summary}</p>
  {href && (
    <a href={href} class="mt-4 inline-block text-xs font-mono uppercase tracking-widest text-[color:var(--color-muted)] hover:text-[color:var(--color-heading)]">Explore →</a>
  )}
</article>
