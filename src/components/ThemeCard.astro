---
interface Props {
  title: string;
  summary: string;
  index?: number;
}
const { title, summary, index = 0 } = Astro.props;
const num = String(index + 1).padStart(2, '0');
---
<article class="reveal gradient-border glass-hover p-6">
  <div class="flex items-baseline justify-between">
    <h3 class="text-lg font-semibold">{title}</h3>
    <span class="font-mono text-xs text-[color:var(--color-muted)]">/{num}</span>
  </div>
  <p class="mt-3 text-sm leading-relaxed text-[color:var(--color-muted)]">{summary}</p>
</article>
