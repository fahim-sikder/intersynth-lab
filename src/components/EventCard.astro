---
interface Props {
  title: string;
  date: Date;
  location?: string;
  type?: string;
  link?: string;
  status?: string;
  excerpt?: string;
}
const { title, date, location, type = 'event', link, status = 'upcoming', excerpt } = Astro.props;
const fmt = new Intl.DateTimeFormat('en', { year: 'numeric', month: 'long', day: 'numeric' });
---
<article class="reveal gradient-border glass-hover p-6">
  <div class="flex items-center justify-between text-xs">
    <span class="chip">
      <span class:list={[
        'inline-block h-1.5 w-1.5 rounded-full',
        status === 'upcoming' ? 'bg-emerald-400' : 'bg-zinc-400',
      ]}></span>
      {status}
    </span>
    <span class="font-mono uppercase tracking-widest text-[color:var(--color-muted)]">{type}</span>
  </div>
  <h3 class="mt-4 text-lg font-semibold leading-snug">{title}</h3>
  <div class="mt-2 flex flex-wrap items-center gap-3 text-xs text-[color:var(--color-muted)]">
    <time class="font-mono" datetime={date.toISOString()}>{fmt.format(date)}</time>
    {location && <span>· {location}</span>}
  </div>
  {excerpt && <p class="mt-3 text-sm text-[color:var(--color-muted)]">{excerpt}</p>}
  {link && (
    <a href={link} target="_blank" rel="noopener" class="mt-4 inline-flex text-xs font-mono text-[color:var(--color-accent-cyan)] hover:underline">
      Details →
    </a>
  )}
</article>
