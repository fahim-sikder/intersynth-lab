---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
}
const { eyebrow, title, subtitle, align = 'left' } = Astro.props;
---
<div class:list={['reveal max-w-3xl', align === 'center' ? 'mx-auto text-center' : '']}>
  {eyebrow && <span class="chip">{eyebrow}</span>}
  <h2 class="mt-4 text-3xl font-semibold tracking-tight sm:text-4xl">{title}</h2>
  {subtitle && <p class="mt-4 text-base text-[color:var(--color-muted)] sm:text-lg">{subtitle}</p>}
</div>
