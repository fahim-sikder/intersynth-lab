---
interface Props {
  id?: string;
  name: string;
  role: string;
  affiliation: string;
  email?: string;
  bio?: string;
  group?: string;
}
const { id, name, role, affiliation, email, bio, group } = Astro.props;
const initials = name
  .split(/\s+/)
  .map((w) => w[0])
  .filter(Boolean)
  .slice(0, 2)
  .join('')
  .toUpperCase();
const href = id ? `/people/${id}` : undefined;
---
<article class="reveal gradient-border glass-hover p-6">
  <div class="flex items-center gap-4">
    <div
      class="grid h-14 w-14 shrink-0 place-items-center rounded-full text-lg font-semibold text-white"
      style="background: linear-gradient(135deg, rgba(34,211,238,0.35), rgba(168,85,247,0.45));"
      aria-hidden="true"
    >{initials}</div>
    <div>
      <h3 class="text-lg font-semibold leading-tight">
        {href ? <a href={href} class="hover:text-[color:var(--color-accent-cyan)]">{name}</a> : name}
      </h3>
      <p class="mt-0.5 text-xs uppercase tracking-widest text-[color:var(--color-muted)] font-mono">{role}</p>
    </div>
  </div>
  <p class="mt-4 text-sm text-[color:var(--color-text)]">{affiliation}</p>
  {bio && <p class="mt-3 text-sm text-[color:var(--color-muted)]">{bio}</p>}
  <div class="mt-4 flex flex-wrap items-center gap-3">
    {email && (
      <a href={`mailto:${email}`} class="text-xs font-mono text-[color:var(--color-accent-cyan)] hover:underline">
        {email}
      </a>
    )}
    {href && (
      <a href={href} class="text-xs font-mono text-[color:var(--color-muted)] hover:text-[color:var(--color-heading)]">
        Profile →
      </a>
    )}
  </div>
  {group === 'pi' && (
    <div class="mt-4 inline-flex"><span class="chip">Principal Investigator</span></div>
  )}
</article>
