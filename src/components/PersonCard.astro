---
interface Links {
  website?: string;
  scholar?: string;
  github?: string;
  orcid?: string;
}
interface Props {
  id?: string;
  name: string;
  role: string;
  affiliation: string;
  email?: string;
  bio?: string;
  photo?: string;
  links?: Links;
}
const { id, name, role, affiliation, email, bio, photo, links = {} } = Astro.props;
const orcidUrl = links.orcid
  ? (links.orcid.startsWith('http') ? links.orcid : `https://orcid.org/${links.orcid}`)
  : undefined;
const initials = name
  .split(/\s+/)
  .map((w) => w[0])
  .filter(Boolean)
  .slice(0, 2)
  .join('')
  .toUpperCase();
const href = id ? `/people/${id}` : undefined;
---
<article class="reveal gradient-border glass-hover p-6">
  <div class="flex items-center gap-4">
    {photo ? (
      <img
        src={photo}
        alt={name}
        loading="lazy"
        decoding="async"
        class="h-14 w-14 shrink-0 rounded-full object-cover"
        style="border: 1px solid var(--color-border);"
      />
    ) : (
      <div
        class="grid h-14 w-14 shrink-0 place-items-center rounded-full text-lg font-semibold text-white"
        style="background: linear-gradient(135deg, rgba(34,211,238,0.35), rgba(168,85,247,0.45));"
        aria-hidden="true"
      >{initials}</div>
    )}
    <div>
      <h3 class="text-lg font-semibold leading-tight">
        {href ? <a href={href} class="hover:text-[color:var(--color-accent-cyan)]">{name}</a> : name}
      </h3>
      <p class="mt-0.5 text-xs uppercase tracking-widest text-[color:var(--color-muted)] font-mono">{role}</p>
    </div>
  </div>
  <p class="mt-4 text-sm text-[color:var(--color-text)]">{affiliation}</p>
  {bio && <p class="mt-3 text-sm text-[color:var(--color-muted)]">{bio}</p>}
  <div class="mt-5 flex flex-wrap gap-2">
    {href && (
      <a href={href} class="chip hover:text-[color:var(--color-heading)]">Profile</a>
    )}
    {links.website && (
      <a href={links.website} target="_blank" rel="noopener" class="chip hover:text-[color:var(--color-heading)]">Website ↗</a>
    )}
    {links.scholar && (
      <a href={links.scholar} target="_blank" rel="noopener" class="chip hover:text-[color:var(--color-heading)]">Google Scholar ↗</a>
    )}
    {links.github && (
      <a href={links.github} target="_blank" rel="noopener" class="chip hover:text-[color:var(--color-heading)]">GitHub ↗</a>
    )}
    {orcidUrl && (
      <a href={orcidUrl} target="_blank" rel="noopener" class="chip hover:text-[color:var(--color-heading)]">ORCID ↗</a>
    )}
  </div>
</article>
