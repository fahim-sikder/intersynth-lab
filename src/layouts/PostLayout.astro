---
import BaseLayout from './BaseLayout.astro';
interface Heading { depth: number; slug: string; text: string }
interface Props {
  title: string;
  date?: Date;
  description?: string;
  backHref?: string;
  backLabel?: string;
  minutes?: number;
  headings?: Heading[];
  image?: string;
}
const { title, date, description, backHref = '/news', backLabel = 'Back to News', minutes, headings = [], image } = Astro.props;
const fmt = new Intl.DateTimeFormat('en', { year: 'numeric', month: 'long', day: 'numeric' });
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---
<BaseLayout title={`${title} — InterSynth Lab`} description={description} image={image}>
  <article class="container-page max-w-5xl py-20 lg:grid lg:grid-cols-[minmax(0,1fr)_220px] lg:gap-12">
    <div class="min-w-0">
      <a href={backHref} class="text-xs font-mono uppercase tracking-widest text-[color:var(--color-muted)] hover:text-[color:var(--color-heading)]">← {backLabel}</a>
      <h1 class="mt-6 text-4xl font-semibold tracking-tight sm:text-5xl">{title}</h1>
      <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-sm text-[color:var(--color-muted)]">
        {date && <time datetime={date.toISOString()}>{fmt.format(date)}</time>}
        {minutes && <span aria-label="Reading time">· {minutes} min read</span>}
      </div>
      <div class="prose prose-invert mt-8 max-w-none text-[color:var(--color-text)]">
        <slot />
      </div>
    </div>
    {toc.length > 0 && (
      <aside class="mt-12 hidden lg:block">
        <div class="sticky top-24 border-l border-[color:var(--color-border)] pl-4">
          <p class="font-mono text-[10px] uppercase tracking-widest text-[color:var(--color-muted)]">On this page</p>
          <ol class="mt-3 flex flex-col gap-2 text-sm">
            {toc.map((h) => (
              <li class={h.depth === 3 ? 'pl-3' : ''}>
                <a href={`#${h.slug}`} class="text-[color:var(--color-muted)] hover:text-[color:var(--color-heading)]">{h.text}</a>
              </li>
            ))}
          </ol>
        </div>
      </aside>
    )}
  </article>
</BaseLayout>

<style is:global>
  .prose p { margin-block: 1rem; line-height: 1.75; }
  .prose a { color: var(--color-accent-cyan); text-decoration: underline; text-decoration-style: dotted; }
  .prose h2 { font-size: 1.5rem; margin-top: 2.5rem; }
  .prose h3 { font-size: 1.2rem; margin-top: 2rem; }
  .prose ul { list-style: disc; padding-left: 1.25rem; }
  .prose code { background: rgba(255,255,255,0.06); padding: 0.1rem 0.35rem; border-radius: 0.25rem; font-family: var(--font-mono); }
</style>
