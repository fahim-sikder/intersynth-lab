---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'InterSynth Lab - Synthetic Data: Facts, Representations, and Transparency',
  description = 'An interdisciplinary WASP-HS research lab investigating synthetic data - its facts, representations, and transparency — across the social and computer sciences.',
  image = '/og/default.svg',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---
<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      (function () {
        var apply = function () {
          try {
            var stored = localStorage.getItem('theme');
            var theme = stored === 'light' || stored === 'dark' ? stored : 'dark';
            document.documentElement.dataset.theme = theme;
          } catch (e) {
            document.documentElement.dataset.theme = 'dark';
          }
        };
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site).toString()} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <ClientRouter />
    <link rel="alternate" type="application/rss+xml" title="InterSynth Lab — News" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <Header />
    <main class="relative z-10" data-pagefind-body>
      <slot />
    </main>
    <Footer />

    <script>
      const initReveal = () => {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12 },
        );
        document.querySelectorAll('.reveal:not(.is-visible)').forEach((el) => observer.observe(el));
      };
      initReveal();
      document.addEventListener('astro:page-load', initReveal);

      // Re-decode Cloudflare-obfuscated emails after view-transition swaps,
      // because cf's email-decode.min.js only runs on full page load.
      const decodeCfEmails = () => {
        const decode = (encoded) => {
          const r = parseInt(encoded.slice(0, 2), 16);
          let out = '';
          for (let i = 2; i < encoded.length; i += 2) {
            out += String.fromCharCode(parseInt(encoded.slice(i, i + 2), 16) ^ r);
          }
          return out;
        };
        document.querySelectorAll('span.__cf_email__[data-cfemail]').forEach((span) => {
          try {
            const email = decode(span.getAttribute('data-cfemail'));
            const text = document.createTextNode(email);
            span.replaceWith(text);
            const link = text.parentElement?.closest('a[href*="/cdn-cgi/l/email-protection"]');
            if (link) link.setAttribute('href', `mailto:${email}`);
          } catch {}
        });
        document.querySelectorAll('a[href*="/cdn-cgi/l/email-protection#"]').forEach((a) => {
          const href = a.getAttribute('href') || '';
          const idx = href.indexOf('#');
          if (idx < 0) return;
          try {
            a.setAttribute('href', `mailto:${decode(href.slice(idx + 1))}`);
          } catch {}
        });
      };
      document.addEventListener('astro:page-load', decodeCfEmails);
    </script>
  </body>
</html>
